echolake:
  target: dev
  outputs:
    dev:
      type: athena
      s3_staging_dir: s3://YOUR_ECHOLAKE_BUCKET/athena-results/
      s3_data_dir: s3://YOUR_ECHOLAKE_BUCKET/warehouse/
      region_name: us-east-1
      database: awsdatacatalog
      schema: echolake_dev_lakehouse
      work_group: echolake-dev-athena
      threads: 4
